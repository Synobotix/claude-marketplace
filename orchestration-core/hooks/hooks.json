{
  "description": "Orchestration-core gate hook — runs deterministic quality gate on Stop",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "GATE_TYPE=${GATE_TYPE:-code} bash \"${CLAUDE_PLUGIN_ROOT}/hooks/gate-runner.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
