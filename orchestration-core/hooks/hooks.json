{
  "description": "Orchestration-core hooks — update check on prompt, quality gate on Stop",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check-update.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "GATE_TYPE=${GATE_TYPE:-code} bash \"${CLAUDE_PLUGIN_ROOT}/hooks/gate-runner.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
